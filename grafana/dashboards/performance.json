{
  "uid": "tp-obs-perf",
  "title": "TP Observabilite - Performance et Disponibilite",
  "tags": ["tp", "flask", "latence"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(app_requetes_total, route)", "refId": "route" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Etat de l'application",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "DOWN", "color": "red" },
              "1": { "text": "UP", "color": "green" }
            } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "min(up{job=\"application\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alertes en cours",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Disponibilite (5 min)",
      "gridPos": { "x": 8, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 95 },
            { "color": "green", "value": 99 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(rate(app_erreurs_total{route=~\"$route\"}[5m])) or vector(0)) / sum(rate(app_requetes_total{route=~\"$route\"}[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latence p95",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.5 },
            { "color": "red", "value": 1 }
          ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(app_latence_secondes_bucket{route=~\"$route\"}[1m])) by (le))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Requetes (1 min)",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(app_requetes_total{route=~\"$route\"}[1m]))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latence p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(app_latence_secondes_bucket{route=~\"$route\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(app_latence_secondes_bucket{route=~\"$route\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(app_latence_secondes_bucket{route=~\"$route\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latence moyenne par route",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(app_latence_secondes_sum{route=~\"$route\"}[1m])) by (route) / sum(rate(app_latence_secondes_count{route=~\"$route\"}[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "Distribution de la latence",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "calculate": false },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(app_latence_secondes_bucket{route=~\"$route\"}[30s])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requetes/s : succes, 4xx, 5xx",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(app_requetes_total{route=~\"$route\", code=~\"2..\"}[30s])) or vector(0)",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(app_requetes_total{route=~\"$route\", code=~\"4..\"}[30s])) or vector(0)",
          "legendFormat": "4xx"
        },
        {
          "refId": "C",
          "expr": "sum(rate(app_requetes_total{route=~\"$route\", code=~\"5..\"}[30s])) or vector(0)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Historique des alertes",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=~\"firing|pending\"}",
          "legendFormat": "{{alertname}} ({{alertstate}})"
        }
      ]
    },
    {
      "id": 11,
      "type": "alertlist",
      "title": "Alertes Grafana",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 7 },
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "folder": { "title": "TP Obs" },
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": ["alerting", "pending"],
        "viewMode": "list"
      }
    }
  ]
}